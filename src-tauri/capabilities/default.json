{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for main and splash windows",
  "windows": [
    "main",
    "splash"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "process:default",
    "process:allow-restart",
    "process:allow-exit",
    "store:default"
  ]
}