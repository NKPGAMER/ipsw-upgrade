{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "paths": {
            "@/*": ["src/*"],
            "@pages/*": ["src/ui/pages/*"],
            "@global-type": ["global.d.ts"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", "**/*.spec.ts"]
}