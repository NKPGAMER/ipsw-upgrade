{
  "name": "ipsw-manager",
  "version": "4.0.3",
  "description": "",
  "main": "electron/dist/main.js",
  "scripts": {
    "start": "npm run dev",
    "publish": "node publish/server.mjs",
    "build": "vite build",
    "build:main": "npx tsc -p tsconfig.main.json",
    "dev": "vite",
    "dev:electron": "npx tsc -p tsconfig.main.json -w",
    "dist": "npm run build:main && npm run build && electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:src": "eslint src/",
    "lint:electron": "eslint electron/",
    "t": "electron .",
    "tauri": "tauri"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.4",
    "electron-builder": "26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-reloader": "^1.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "tailwindcss": "^4.2.1",
    "tauri": "^0.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.3",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "chokidar": "^5.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "i18next": "^25.10.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.2",
    "react-router-dom": "^7.14.0",
    "undici": "^7.24.4",
    "uuid": "^13.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.ipsw.manager",
    "productName": "IPSW Manager",
    "artifactName": "${name}-${version}-setup.${ext}",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "NKPGAMER",
        "repo": "ipsw-manager",
        "private": false
      }
    ],
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "!dist/**/*.map",
      "!electron/dist/**/*.map",
      "!**/test/**",
      "!**/*.log"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "nsis": {
      "differentialPackage": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
