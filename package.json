{
  "name": "ipsw-manager",
  "version": "3.0.0",
  "description": "",
  "main": "electron/dist/main.js",
  "scripts": {
    "build:main": "npx tsc -p electron -w",
    "build:renderer": "npx tsc -w",
    "start": "npm run dev",
    "dist": "npm run build && electron-builder --publish always",
    "dev": "concurrently \"vite\" \"electron .\"",
    "t": "electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-reloader": "^1.2.3",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.1"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "i18next": "^25.10.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "is-online": "^12.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.2",
    "undici": "^7.24.4",
    "usb": "^2.17.0",
    "uuid": "^13.0.0"
  },
  "build": {
    "appId": "com.ipsw.manager",
    "productName": "IPSW Manager",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "NKPGAMER",
        "repo": "ipsw-manager",
        "private": false
      }
    ],
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!**/test/**",
      "!**/*.log"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "nsis": {
      "differentialPackage": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
