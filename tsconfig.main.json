{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        "rootDir": "electron",
        "outDir": "electron/dist",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@root/*": ["./electron/*"],
            "@custom-type/*": ["./@types/*"]
        }
    },
    "include": ["electron", "@types"]
}