        "target": "esnext",
        "module": "commonjs",
        "rootDir": "electron",
        "outDir": "electron/dist",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
    },
    "include": ["electron", "@types", "preload.d.ts", "global.d.ts"]
}