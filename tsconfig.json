{
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        "lib": ["ESNext", "DOM"],
        "outDir": "dist",
        "rootDir": "src",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "resolveJsonModule": true
    },
    "include": ["src", "preload.d.ts", "global.d.ts"],
    "exclude": ["node_modules", "**/*.spec.ts"]
}